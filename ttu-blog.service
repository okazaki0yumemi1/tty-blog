[Unit]
Description=ttu-blog — terminal-styled read-only Markdown blog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER_NAME
Group=YOUR_USER_NAME
WorkingDirectory=/path/to/your/ttu-blog
ExecStart=/usr/bin/node server.js

# --- configuration (edit as needed) ---
Environment=PORT=3000
# Leave empty when the reverse proxy strips the /ttu-blog prefix (current
# setup). Set to /ttu-blog only if the proxy forwards the prefix unchanged.
Environment=BASE_PATH=

Restart=always
RestartSec=3

# --- hardening, in the spirit of the read-only blog ---
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# The blog never writes to disk (posts are edited by you, not the process),
# so a read-only home is fine. If you later add a feature that writes, add:
# ReadWritePaths=/path/to/your/ttu-blog/pages

[Install]
WantedBy=multi-user.target
